# Node and the Dart SDK, pinned, for building the extension's zips the same way
# on any machine. Built and run by tool/build.sh. The Debian image is pinned by
# its digest (the index of debian:bookworm-slim, every platform), and Node and
# the Dart SDK by their SHA-256 below; Dependabot cannot read a Containerfile, so both are bumped by
# hand (CONTRIBUTING.md).
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

# libatomic1: Node's own binary needs it, and the slim image hasn't it. unzip: the
# Dart SDK comes as a zip. git: core/ takes Kemlock-core from GitHub, at the commit
# its pubspec.lock names.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates xz-utils libatomic1 unzip git \
 && rm -rf /var/lib/apt/lists/*

# Node 26.13.0 (LTS), checked against nodejs.org's published SHA-256.
RUN curl -fsSL https://nodejs.org/dist/v26.13.0/node-v26.13.0-linux-x64.tar.xz -o /tmp/node.tar.xz \
 && echo "d28a96af6c38596f6d9d97c0ee531c13d238d757742387d1928de822d959e997  /tmp/node.tar.xz" | sha256sum -c - \
 && mkdir /opt/node && tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1 \
 && rm /tmp/node.tar.xz

# Dart 3.13.5 (stable), which compiles core/ to WebAssembly, checked against the
# SHA-256 Google publishes beside the zip (the same URL with .sha256sum).
RUN curl -fsSL https://storage.googleapis.com/dart-archive/channels/stable/release/3.13.5/sdk/dartsdk-linux-x64-release.zip -o /tmp/dart.zip \
 && echo "ea864bc64df30a6b8bdf30b2e32550f7717d9a890de8f40293aeabb924fe232b  /tmp/dart.zip" | sha256sum -c - \
 && unzip -q /tmp/dart.zip -d /opt \
 && rm /tmp/dart.zip

ENV PATH=/opt/node/bin:/opt/dart-sdk/bin:$PATH \
    PUB_CACHE=/root/.pub-cache \
    DART_SUPPRESS_ANALYTICS=true \
    DART_DISABLE_TELEMETRY=true \
    npm_config_update_notifier=false \
    npm_config_fund=false \
    npm_config_audit=false

WORKDIR /w
