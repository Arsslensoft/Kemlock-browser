{
  "minimum_chrome_version": "119",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["offscreen"],
  "web_accessible_resources": [
    {
      "resources": ["src/menu/index.html"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
