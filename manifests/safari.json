{
  "$remove": {
    "permissions": ["idle", "identity", "clipboardRead"]
  },
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["background.js"],
    "type": "module",
    "persistent": false
  },
  "web_accessible_resources": [
    {
      "resources": ["src/menu/index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "18.4"
    }
  }
}
