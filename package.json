{
  "name": "kemlock-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node tool/build.mjs",
    "tokens": "node tool/tokens.mjs",
    "locales": "node tool/locales.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint:firefox": "node tool/lint-firefox.mjs"
  },
  "dependencies": {
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "web-ext": "10.8.0"
  },
  "license": "GPL-3.0-or-later"
}
